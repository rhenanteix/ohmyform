{
  "version": 2,
  "framework": "nextjs",
  "rootDirectory": "ui",
  "buildCommand": "yarn install --frozen-lockfile && yarn build",
  "devCommand": "yarn dev",
  "installCommand": "yarn install --frozen-lockfile",
  "outputDirectory": ".next",
  "env": {
    "NODE_ENV": "production",
    "NEXT_TELEMETRY_DISABLED": "1",
    "ENDPOINT": "https://sua-api.onrender.com/graphql",
    "SERVER_ENDPOINT": "https://sua-api.onrender.com/graphql"
  }
}
